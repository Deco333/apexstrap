<ui:UiPage
    x:Class="Apexstrap.UI.Elements.Settings.Pages.VersionSelectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Apexstrap.UI.Elements.Settings.Pages"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="900"
    Title="VersionSelectorPage">

    <Grid Margin="20">
        <StackPanel Spacing="20">
            <!-- Header -->
            <TextBlock Text="Roblox Version Manager" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Text="Select which version of Roblox to launch. Apexstrap will automatically search for installed versions or download the selected one if missing." FontSize="14" Opacity="0.8"/>

            <!-- Version Selection -->
            <ui:CardExpander Icon="Desktop24" Header="Active Version" IsExpanded="True">
                <StackPanel Spacing="15" Margin="0,10,0,0">
                    <ComboBox x:Name="VersionComboBox" SelectionChanged="VersionComboBox_SelectionChanged">
                        <ComboBoxItem Content="Latest (Stable)" Tag="latest" IsSelected="True"/>
                        <ComboBoxItem Content="Latest (Beta)" Tag="beta"/>
                        <ComboBoxItem Content="Specific Version (v0.55.0)" Tag="v0.55.0"/>
                        <ComboBoxItem Content="Specific Version (v0.54.0)" Tag="v0.54.0"/>
                        <ComboBoxItem Content="Custom Path" Tag="custom"/>
                    </ComboBox>
                    
                    <Grid x:Name="CustomPathGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CustomPathBox" PlaceholderText="Path to RobloxPlayerBeta.exe" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Browse" Click="BrowsePath_Click"/>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Installation Status -->
            <ui:CardExpander Icon="CheckmarkCircle24" Header="Installation Status" IsExpanded="True">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Detected Versions:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetectedVersionsText" Text="Searching..." />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Active Channel:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ActiveChannelText" Text="Stable" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Download Status:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DownloadStatusText" Text="Up to date" Foreground="Green"/>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Actions -->
            <ui:Card ControlPadding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Actions" FontWeight="Bold"/>
                    <WrapPanel ItemWidth="200">
                        <Button Content="Scan for Installed Versions" Click="ScanVersions_Click" Margin="5" Padding="15,8"/>
                        <Button Content="Download Selected Version" Click="DownloadVersion_Click" Margin="5" Padding="15,8"/>
                        <Button Content="Repair Installation" Click="RepairInstall_Click" Margin="5" Padding="15,8"/>
                        <Button Content="Open Folder" Click="OpenFolder_Click" Margin="5" Padding="15,8"/>
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!-- Progress -->
            <ui:Card x:Name="ProgressCard" Visibility="Collapsed" ControlPadding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ProgressText" Text="Downloading..."/>
                    <ProgressBar x:Name="DownloadProgress" IsIndeterminate="False" Value="0" Maximum="100" Height="20"/>
                    <Button Content="Cancel" HorizontalAlignment="Right" Click="CancelDownload_Click"/>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </Grid>
</ui:UiPage>
