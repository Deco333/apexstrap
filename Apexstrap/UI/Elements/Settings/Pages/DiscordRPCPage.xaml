<ui:UiPage x:Class="Apexstrap.UI.Elements.Settings.Pages.DiscordRPCPage"
      x:Name="DiscordRPCPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:Apexstrap.UI.ViewModels"
      xmlns:controls="clr-namespace:Apexstrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:Apexstrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1080" d:DesignWidth="800"
      Title="DiscordRPCPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_General_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        
        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_DiscordRPC_Enable_Title}" 
            Description="{x:Static resources:Strings.Menu_DiscordRPC_Enable_Description}">
            <ui:ToggleSwitch IsChecked="{Binding DiscordRPCEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_DiscordRPC_ShowDetails_Title}" 
            Description="{x:Static resources:Strings.Menu_DiscordRPC_ShowDetails_Description}"
            IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding DiscordRPCShowDetails, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_Customization_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_ApplicationId_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="1063509994755600434" Text="{Binding DiscordRPCApplicationId, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_LargeImageKey_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="icon_large" Text="{Binding DiscordRPCLargeImageKey, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_LargeImageText_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="Playing Roblox" Text="{Binding DiscordRPCLargeImageText, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_SmallImageKey_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="icon_small" Text="{Binding DiscordRPCSmallImageKey, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_SmallImageText_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="Apexstrap" Text="{Binding DiscordRPCSmallImageText, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_ButtonConfiguration_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_Button1_Label_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="Join Server" Text="{Binding DiscordRPCButton1Label, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_Button1_Url_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="https://roblox.com" Text="{Binding DiscordRPCButton1Url, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_Button2_Label_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="Add Friend" Text="{Binding DiscordRPCButton2Label, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_Button2_Url_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="https://roblox.com/friends" Text="{Binding DiscordRPCButton2Url, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_PresenceText_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_State_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="In Game" Text="{Binding DiscordRPCState, Mode=TwoWay}" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />
        
        <TextBlock Text="{x:Static resources:Strings.Menu_DiscordRPC_Details_Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
        <ui:TextBox Margin="0,4,0,0" PlaceholderText="Playing {gamename}" Text="{Binding DiscordRPCDetails, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="{Binding DiscordRPCEnabled, Mode=OneWay}" />

        <ui:Button Content="{x:Static resources:Strings.Common_Save}" Appearance="Primary" HorizontalAlignment="Right" Margin="0,16,0,0" Command="{Binding SaveDiscordRPCSettingsCommand, Mode=OneWay}" />
    </StackPanel>
</ui:UiPage>
